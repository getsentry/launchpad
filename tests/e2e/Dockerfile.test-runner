FROM python:3.14-slim

WORKDIR /app

# Install system dependencies (librdkafka needed by confluent-kafka via taskbroker-client)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    g++ \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python test dependencies
RUN pip install --no-cache-dir \
    pytest==8.3.3 \
    requests==2.32.3 \
    boto3==1.35.0

# Install launchpad package (gives us process_artifact.delay() via taskbroker-client)
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY src/ /tmp/src/
COPY pyproject.toml /tmp/pyproject.toml
COPY README.md /tmp/README.md
COPY LICENSE /tmp/LICENSE
RUN pip install --no-cache-dir /tmp/

# Copy only E2E test files (not the main test suite)
# Copy to root to avoid pytest finding parent conftest.py
COPY tests/e2e /app/e2e_tests
COPY tests/_fixtures /app/fixtures

# Create results directory
RUN mkdir -p /app/results

WORKDIR /app

FROM python:3.14-slim

# Install uv
RUN python3 -m pip --no-cache-dir --disable-pip-version-check install 'uv==0.11.17'

ENV UV_SYSTEM_PYTHON=1

WORKDIR /app

# Install system dependencies (librdkafka needed by confluent-kafka via taskbroker-client)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    g++ \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests first for layer caching
COPY pyproject.toml uv.lock ./

# Install launchpad dependencies + e2e test deps, skip dev tools
RUN uv sync --frozen --no-dev --group e2e --no-install-project

# Copy source and install the project
COPY src/ ./src/
COPY README.md LICENSE ./
RUN uv sync --frozen --no-dev --group e2e

# Copy only E2E test files (not the main test suite)
# Copy to root to avoid pytest finding parent conftest.py
COPY tests/e2e /app/e2e_tests
COPY tests/_fixtures /app/fixtures

# Create results directory
RUN mkdir -p /app/results

WORKDIR /app
